<?xml version="1.0" encoding="utf-8"?>
<!-- [STATION-LOGO] Bingkai marquee Cinema: tepi gradasi marun -> emas, isi gelap. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="@color/cinema_maroon" android:endColor="@color/cinema_gold" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:bottom="3dp" android:left="3dp" android:right="3dp" android:top="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#FF0A0A0A" />
            <corners android:radius="19dp" />
        </shape>
    </item>
</layer-list>
