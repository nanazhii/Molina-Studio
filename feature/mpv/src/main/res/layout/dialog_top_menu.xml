<?xml version="1.0" encoding="utf-8"?>
<!-- [MENU-COMPACT] baris 40dp (sebelumnya 48dp), padding 2dp. Molina: menu setting = strip ikon vertikal (didok di pojok kanan-bawah oleh MPVActivity).
     ID tombol tetap. Dibungkus ScrollView agar muat di layar landscape. Tekan lama = tooltip. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false"
    android:overScrollMode="ifContentScrolls"
    android:scrollbars="none"
    android:fadingEdge="vertical"
    android:fadingEdgeLength="28dp"
    android:requiresFadingEdge="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingVertical="2dp">

        <!-- Since this dialog scrolls only on small screens, don't add too many buttons here! -->

        <ImageButton
        android:id="@+id/playlistBtn"
        style="@style/Widget.Molina.MenuIcon"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:minWidth="0dp"
        android:minHeight="40dp"
        android:contentDescription="@string/action_playlist"
        android:tooltipText="@string/action_playlist"
        android:src="@drawable/ic_menu_playlist" />

        <ImageButton
        android:id="@+id/menuSearchBtn"
        style="@style/Widget.Molina.MenuIcon"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:minWidth="0dp"
        android:minHeight="40dp"
        android:contentDescription="@string/action_open_url"
        android:tooltipText="@string/action_open_url"
        android:src="@drawable/ic_menu_search" /> <!-- [MENU-SCROLL] -->

        <ImageButton
        android:id="@+id/bookmarkBtn"
        style="@style/Widget.Molina.MenuIcon"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:minWidth="0dp"
        android:minHeight="40dp"
        android:contentDescription="@string/action_bookmarks"
        android:tooltipText="@string/action_bookmarks"
        android:src="@drawable/ic_menu_bookmarks" />

        <LinearLayout
        android:id="@+id/rowMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/backgroundBtn"
            style="@style/Widget.Molina.MenuIcon"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:minHeight="40dp"
            android:contentDescription="@string/resume_bg_playback"
            android:tooltipText="@string/resume_bg_playback"
            android:src="@drawable/ic_menu_headset" />

        <ImageButton
            android:id="@+id/qualityIconBtn"
            style="@style/Widget.Molina.MenuIcon"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:minHeight="40dp"
            android:contentDescription="@string/quality_sheet_title"
            android:tooltipText="@string/quality_sheet_title"
            android:src="@drawable/ic_menu_quality" />

        <ImageButton
            android:id="@+id/audioLangBtn"
            style="@style/Widget.Molina.MenuIcon"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:minHeight="40dp"
            android:contentDescription="@string/audio_lang_btn"
            android:tooltipText="@string/audio_lang_btn"
            android:src="@drawable/ic_menu_audio_lang" /> <!-- [AUDIO-LANG] -->

    </LinearLayout>

        <LinearLayout
        android:id="@+id/rowChapter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/chapterBtn"
            style="@style/Widget.Molina.MenuIcon"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:minHeight="40dp"
            android:contentDescription="@string/chapter_button"
            android:tooltipText="@string/chapter_button"
            android:src="@drawable/ic_menu_chapters" />

        <ImageButton
            android:id="@+id/chapterPrev"
            style="@style/Widget.Molina.MenuIcon"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:minHeight="40dp"
            android:contentDescription="@string/dialog_prev"
            android:tooltipText="@string/dialog_prev"
            android:src="@drawable/ic_menu_prev" />

        <ImageButton
            android:id="@+id/chapterNext"
            style="@style/Widget.Molina.MenuIcon"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:minHeight="40dp"
            android:contentDescription="@string/dialog_next"
            android:tooltipText="@string/dialog_next"
            android:src="@drawable/ic_menu_next" />

    </LinearLayout>

        <ImageButton
        android:id="@+id/menuLockBtn"
        style="@style/Widget.Molina.MenuIcon"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:minWidth="0dp"
        android:minHeight="40dp"
        android:contentDescription="@string/menu_lock_screen"
        android:tooltipText="@string/menu_lock_screen"
        android:src="@drawable/ic_lock_24dp" /> <!-- [MENU-SCROLL] -->

        <ImageButton
        android:id="@+id/menuPipBtn"
        style="@style/Widget.Molina.MenuIcon"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:minWidth="0dp"
        android:minHeight="40dp"
        android:contentDescription="@string/menu_pip"
        android:tooltipText="@string/menu_pip"
        android:src="@drawable/ic_picture_in_picture_24dp" /> <!-- [MENU-SCROLL] -->

        <ImageButton
        android:id="@+id/advancedBtn"
        style="@style/Widget.Molina.MenuIcon"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:minWidth="0dp"
        android:minHeight="40dp"
        android:contentDescription="@string/advanced_menu"
        android:tooltipText="@string/advanced_menu"
        android:src="@drawable/ic_menu_tune" />

        <ImageButton
        android:id="@+id/orientationBtn"
        style="@style/Widget.Molina.MenuIcon"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:minWidth="0dp"
        android:minHeight="40dp"
        android:contentDescription="@string/switch_orientation"
        android:tooltipText="@string/switch_orientation"
        android:src="@drawable/ic_menu_rotate" />

    </LinearLayout>

</ScrollView>
