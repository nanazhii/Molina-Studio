<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/channelRow"
    android:layout_width="match_parent"
    android:layout_height="58dp"
    android:layout_marginVertical="1dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:background="@drawable/bg_channel_row">

    <TextView
        android:id="@+id/channelNumber"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:textSize="13sp"
        tools:text="001" />

    <TextView
        android:id="@+id/channelAvatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_channel_avatar"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="TJ" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@android:id/text1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textSize="16sp"
            tools:text="TVRI Jawa Timur" />

        <TextView
            android:id="@+id/channelStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:letterSpacing="0.14"
            android:text="@string/playlist_live"
            android:textColor="#FF5C5C"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <com.molina.cinema.EqualizerView
        android:id="@+id/channelEq"
        android:layout_width="18dp"
        android:layout_height="16dp"
        android:layout_marginStart="10dp"
        android:visibility="gone" />

</LinearLayout>
