# ============================================================================
# Molina Studio - .gitignore
#
# Keeps build output, local configuration, credentials and developer-specific
# files out of version control. Contributors: put personal ignore rules in
# .git/info/exclude or your global gitignore, not in this file.
# ============================================================================

# --- Operating system -------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*~
*.swp
*.swo

# --- IDE and editor ---------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/
.fleet/
.kotlin/
.project
.classpath
.settings/

# --- Gradle and Android build output ----------------------------------------
.gradle/
build/
out/
captures/
.cxx/
.externalNativeBuild/
local.properties
*.apk
*.aab
*.ap_
*.dex
*.class
lint-results*.xml
lint-results*.html
lint-baseline.tmp.xml

# --- Native build artifacts (generated by CI or local native builds) --------
/_native*/
/native/build/
/native/out/
feature/mpv/src/main/jniLibs/

# --- Signing keys, certificates and credentials -----------------------------
# Never commit signing material or secrets of any kind.
*.jks
*.keystore
*.p12
*.pfx
*.p8
*.key
*.pem
*.gpg
keystore.properties
signing.properties
key.properties
secrets.properties
google-services.json
service-account*.json
credentials.json
.env
.env.*
.netrc
.git-credentials
.ssh/
id_rsa*
id_ed25519*
# Exceptions: public CA bundle shipped with the player module
!feature/mpv/src/main/assets/cacert.pem
!.env.example

# --- Logs, crash dumps and diagnostics --------------------------------------
logs/
*-logs/
*.log
*.hprof
*.trace
*.pcap
bugreport*.zip
logcat*.txt
tombstone_*
anr_*.txt

# --- Python tooling ---------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Temporary, backup and patch files --------------------------------------
*.bak
*.bak[0-9]*
*.orig
*.rej
*.patch
*.diff
*.tmp
*.temp
patch_*.py
*_patch_*.sh

# One-off helper scripts and archives placed at the repository root
/*.py
/*.sh
/*.zip
/*.tar
/*.tar.gz
/*.tgz

# --- Local, non-public workspace --------------------------------------------
# Notes, drafts and tooling that are not part of the published project.
/docs/internal/
/docs/private/
/internal/
/private/
/.private/
/.local/
/.backup/
*.local.md
*.private.md
*.mvlt
*.mvr
*.mvault
